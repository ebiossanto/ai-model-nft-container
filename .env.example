# Configurações da Rede Blockchain
RPC_URL="https://sepolia.infura.io/v3/YOUR_INFURA_KEY"
PRIVATE_KEY="SUA_CHAVE_PRIVADA_DA_CARTEIRA_WEB3"
CONTRACT_ADDRESS="0xO_ENDERECO_DO_CONTRATO_APOS_O_DEPLOY"

# Configurações do Oráculo (Chainlink Functions)
ORACLE_NODE_URL="https://functions.network"
CHAINLINK_SUBSCRIPTION_ID="YOUR_SUBSCRIPTION_ID"

# Configurações de IPFS/Arweave
PINATA_API_KEY="YOUR_PINATA_API_KEY"
PINATA_SECRET_KEY="YOUR_PINATA_SECRET_KEY"
ARWEAVE_WALLET_PATH="./arweave-wallet.json"

# Configurações da Sandbox
TEE_MODE="simulation"  # simulation | production
INTEL_SGX_ENABLED=false
AMD_SEV_ENABLED=false
